NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://aura:aura_secret@127.0.0.1:55432/auraai?schema=public

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# OpenAI product research (web search → structured catalog)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=90000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

FRONTEND_URL=http://localhost:3001

# Brevo (transactional email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Aura AI

# Midtrans (Sandbox)
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

BCRYPT_ROUNDS=12
LOG_LEVEL=info

# Redis reserved for future session / rate-limit store
REDIS_URL=redis://localhost:6379
